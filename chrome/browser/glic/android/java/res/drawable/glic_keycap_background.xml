<!--docerion
type: asset
title: Glic keycap background drawable
summary: Shape drawable giving Glic keycaps a rounded rectangle background with a secondary fill and a 1dp divider-colored stroke.
-->

<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/default_bg_color_secondary" />
    <stroke
        android:width="1dp"
        android:color="@color/divider_color" />
    <corners android:radius="4dp" />
</shape>
