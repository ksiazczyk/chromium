<!--docerion
type: source
title: Read Aloud radio button layout
summary: Android XML layout defining a single non-focusable radio button used in Read Aloud menu items.
-->

<RadioButton
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/readaloud_radio_button"
    android:layout_width="24dp"
    android:layout_height="24dp"
    android:layout_gravity="center_vertical"
    android:focusable="false"
    android:importantForAccessibility="no"/>