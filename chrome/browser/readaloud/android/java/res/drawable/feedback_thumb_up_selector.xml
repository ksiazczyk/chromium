<!--docerion
type: asset
title: Thumb up feedback state selector
summary: Selector drawable that switches the thumb-up feedback icon between outline and filled primary-tinted states when selected.
-->

<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:state_selected="true"
        android:drawable="@drawable/thumb_up_filled_24"
        android:tint="?attr/colorPrimary" />
      <item
        android:drawable="@drawable/thumb_up_24" />
</selector>