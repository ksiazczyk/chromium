<!--docerion
type: config
title: Read aloud mode selector color state list
summary: Android color selector resource that switches the read aloud mode selector color between the selected and default control colors.
-->

<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true" android:color="?attr/colorOnPrimary"/>
    <item android:color="?attr/colorControlNormal"/>
</selector>