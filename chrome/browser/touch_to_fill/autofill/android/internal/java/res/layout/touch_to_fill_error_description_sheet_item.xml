<!--docerion
type: source
title: Touch to fill error description sheet item layout
summary: Android layout for the centered, screen-reader-focusable error description text shown in the touch-to-fill error sheet.
-->

<TextView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/touch_to_fill_error_description"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/ttf_for_sheet_item_margin_horizontal"
    android:gravity="center"
    android:screenReaderFocusable="true"
    android:textAppearance="@style/TextAppearance.TextMedium.Secondary"/>
