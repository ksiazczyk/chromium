<!--docerion
type: asset
title: Header title text color selector for feed
summary: Android color selector resource that styles feed header title text, using colorOnSurfaceVariant when enabled and a dimmed colorOnSurface when disabled.
-->

<selector xmlns:android="http://schemas.android.com/apk/res/android">
  <item android:alpha="@dimen/default_disabled_alpha"
      android:color="?attr/colorOnSurface" android:state_enabled="false"/>
  <item android:color="?attr/colorOnSurfaceVariant" />
</selector>
