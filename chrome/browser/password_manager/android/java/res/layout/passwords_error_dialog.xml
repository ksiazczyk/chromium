<!-- Used by ExportErrorDialogFragment of passwords preferences. -->

<!--docerion
type: source
title: Password export error dialog layout
summary: Android layout for the password export error dialog used by ExportErrorDialogFragment in passwords preferences.
-->

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    style="@style/AlertDialogContent">

    <TextView
        android:id="@+id/passwords_error_main_description"
        android:layout_height="wrap_content"
        android:layout_width="match_parent"/>

    <TextView
        android:id="@+id/passwords_error_detailed_description"
        android:layout_marginTop="14dp"
        android:layout_height="wrap_content"
        android:layout_width="match_parent"/>

</LinearLayout>
