<!--docerion
type: source
title: Home modules recycler view layout
summary: Android layout XML that instantiates the custom HomeModulesRecyclerView for the magic stack home surface, initially hidden and non-focusable.
-->

<org.chromium.chrome.browser.magic_stack.HomeModulesRecyclerView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/home_modules_recycler_view"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:visibility="gone"
    android:focusable="false"
    app:layout_scrollFlags="scroll" />