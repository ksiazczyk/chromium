<!--docerion
type: config
title: Privacy Guide explanation view attributes
summary: Declares custom styleable attributes such as titleText, iconImage, iconTint and summaryText for the Android Privacy Guide explanation views.
-->

<resources>
  <declare-styleable name="PrivacyGuideExplanationHeading">
        <attr name="titleText" format="reference|string" />
  </declare-styleable>
  <declare-styleable name="PrivacyGuideExplanationItem">
        <attr name="iconImage" format="integer" />
        <attr name="iconTint" format="color" />
        <attr name="summaryText" format="reference|string" />
  </declare-styleable>
</resources>
