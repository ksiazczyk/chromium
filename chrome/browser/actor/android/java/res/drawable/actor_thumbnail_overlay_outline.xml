<!--docerion
type: asset
title: Actor thumbnail overlay outline drawable
summary: Android shape drawable with a transparent fill and corner radii matching the tab grid card thumbnail, used as an outline for the actor thumbnail overlay.
-->

<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <solid android:color="@android:color/transparent" />
    <corners
        android:topLeftRadius="@dimen/tab_grid_card_thumbnail_corner_radius_top"
        android:topRightRadius="@dimen/tab_grid_card_thumbnail_corner_radius_top"
        android:bottomLeftRadius="@dimen/tab_grid_card_thumbnail_corner_radius_bottom"
        android:bottomRightRadius="@dimen/tab_grid_card_thumbnail_corner_radius_bottom" />
</shape>
