<!--docerion
type: asset
title: Task card background drawable
summary: Android shape drawable that renders the task manager card background as a rounded rectangle using the default background color macro and the task item corner radius dimension.
-->

<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@macro/default_bg_color" />
    <corners android:radius="@dimen/task_item_corner_radius" />
</shape>
