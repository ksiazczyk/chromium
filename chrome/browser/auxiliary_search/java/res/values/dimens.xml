<!--docerion
type: config
title: Auxiliary search dimension resources
summary: Defines Android dimension values such as favicon size and module padding used by the auxiliary search UI.
-->

<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Auxiliary search dimensions. -->
    <dimen name="auxiliary_search_favicon_size">36dp</dimen>

    <!-- Auxiliary search module dimensions. -->
    <dimen name="auxiliary_search_module_padding_start">20dp</dimen>
    <dimen name="auxiliary_search_module_title_padding_bottom">2dp</dimen>
    <dimen name="auxiliary_search_module_title_margin_bottom">8dp</dimen>
    <dimen name="auxiliary_search_module_content_margin_bottom">4dp</dimen>
    <dimen name="auxiliary_search_module_button_start_padding">24dp</dimen>
    <dimen name="auxiliary_search_module_button_padding_middle">16dp</dimen>
</resources>
