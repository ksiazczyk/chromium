<!--docerion
type: asset
title: PDF edit button tint color selector
summary: Android color state list XML that defines the tint colors for the PDF edit button, covering disabled, selected, and default icon color states.
-->

<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:alpha="@dimen/default_disabled_alpha"
          android:state_enabled="false" android:color="@macro/default_icon_color" />
    <item android:state_selected="true" android:color="?attr/colorOnSecondaryContainer" />
    <item android:color="@macro/default_icon_color"/>
</selector>
