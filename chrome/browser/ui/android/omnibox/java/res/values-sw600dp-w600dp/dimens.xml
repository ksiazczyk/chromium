<!--docerion
type: config
title: Omnibox suggestion dropdown dimensions for 600dp screens
summary: Defines dimension values such as dropdown side spacing, list top padding, and icon area size for the omnibox suggestion dropdown on 600dp screen configurations.
-->

<resources>
    <!--
    Additional space on the left and right side of the suggestions dropdown.
    -->
    <dimen name="omnibox_suggestion_dropdown_side_spacing">4dp</dimen>
    <dimen name="omnibox_suggestion_list_padding_top">8dp</dimen>
    <dimen name="omnibox_suggestion_icon_area_size">56dp</dimen>
</resources>
