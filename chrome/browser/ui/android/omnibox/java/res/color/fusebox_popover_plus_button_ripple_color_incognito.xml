<!--docerion
type: config
title: Fusebox popover plus button ripple color incognito
summary: Android color selector defining the incognito ripple color and alpha for the Fusebox popover plus button in pressed and hovered states.
-->

<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:alpha="@dimen/fusebox_popover_plus_button_pressed_alpha"
        android:color="@color/baseline_neutral_90"
        android:state_pressed="true" />
    <item
        android:alpha="@dimen/fusebox_popover_plus_button_hovered_alpha"
        android:color="@color/baseline_neutral_90"
        android:state_hovered="true" />
    <item android:color="@android:color/transparent" />
</selector>
