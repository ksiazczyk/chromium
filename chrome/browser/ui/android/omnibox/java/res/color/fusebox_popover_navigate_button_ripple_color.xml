<!--docerion
type: config
title: Fusebox popover navigate button ripple color
summary: Android color selector defining ripple color and alpha for the Fusebox popover navigate button in pressed, focused, and hovered states.
-->

<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:alpha="@dimen/fusebox_popover_navigate_button_pressed_alpha"
        android:color="?attr/colorOnPrimary"
        android:state_pressed="true" />
    <item
        android:alpha="@dimen/fusebox_popover_navigate_button_focused_alpha"
        android:color="?attr/colorOnPrimary"
        android:state_focused="true" />
    <item
        android:alpha="@dimen/fusebox_popover_navigate_button_hovered_alpha"
        android:color="?attr/colorOnPrimary"
        android:state_hovered="true" />
    <item android:color="@android:color/transparent" />
</selector>
