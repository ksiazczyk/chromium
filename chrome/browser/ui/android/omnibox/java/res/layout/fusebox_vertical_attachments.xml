<!--docerion
type: source
title: Fusebox vertical attachments layout
summary: Vertical list layout composing Fusebox attachment actions such as current tab, picture, camera, and tabs.
-->

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:importantForAccessibility="no">

    <include
        layout="@layout/fusebox_list_item"
        android:id="@+id/fusebox_add_current_tab"
        android:visibility="gone"/>

    <include
        layout="@layout/fusebox_list_item"
        android:id="@+id/fusebox_pick_picture_button"/>

    <include
        layout="@layout/fusebox_list_item"
        android:id="@+id/fusebox_camera_button"/>

    <include
        layout="@layout/fusebox_list_item"
        android:id="@+id/fusebox_pick_tabs_button"
        android:visibility="gone"/>

</LinearLayout>
