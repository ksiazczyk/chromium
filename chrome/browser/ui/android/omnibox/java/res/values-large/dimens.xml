<!--docerion
type: config
title: Large-screen dimension for drive consent dialog content inset
summary: Defines an 8dp content inset for the drive consent dialog on large screens so the web view's square corners stay inside the dialog's rounded card.
-->

<resources>
    <!-- Insets the web view so its square corners stay inside the dialog's rounded card. -->
    <dimen name="drive_consent_dialog_content_inset">8dp</dimen>
</resources>
