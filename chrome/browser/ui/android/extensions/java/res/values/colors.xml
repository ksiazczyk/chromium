    <color name="empty_state_extensions_gradient_start">@color/material_primary_90</color>
    <color name="empty_state_extensions_gradient_end">@color/material_secondary_90</color>
    <color name="empty_state_extensions_primary">@color/material_primary_60</color>
    <color name="empty_state_extensions_bg">@color/material_secondary_80</color>
    <color name="empty_state_extensions_stroke">@color/material_secondary_60</color>
</resources>

