-->

<resources>
   <color name="empty_state_extensions_gradient_start">@color/material_primary_30</color>
    <color name="empty_state_extensions_gradient_end">@color/material_secondary_30</color>
    <color name="empty_state_extensions_primary">@color/material_primary_80</color>
    <color name="empty_state_extensions_bg">@color/material_secondary_30</color>
    <color name="empty_state_extensions_stroke">@color/material_secondary_70</color>
</resources>

