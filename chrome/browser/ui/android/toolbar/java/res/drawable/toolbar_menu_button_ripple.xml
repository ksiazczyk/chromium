<!--docerion
type: asset
title: Toolbar menu button ripple
summary: Ripple drawable that provides touch feedback around the toolbar menu button's icon background.
-->

<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="?android:attr/colorControlHighlight"
    android:paddingStart="@dimen/button_end_padding">
  <item
      android:id="@android:id/content"
      android:width="@dimen/large_icon_background_size"
      android:height="@dimen/large_icon_background_size"
      android:gravity="center"
      android:drawable="@drawable/default_icon_background_selector" />
</ripple>
