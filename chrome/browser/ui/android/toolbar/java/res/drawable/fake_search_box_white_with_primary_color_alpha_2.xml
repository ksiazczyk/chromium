<!--docerion
type: asset
title: Fake search box white with primary color alpha 2 drawable
summary: Layer-list that draws a white rounded rectangle overlaid with translucent primary color for the fake search box appearance.
-->

<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
  <item>
    <shape android:shape="rectangle">
      <solid android:color="@android:color/white" />
      <corners android:radius="@dimen/home_surface_search_box_background_radius" />
    </shape>
  </item>
  <item>
    <shape android:shape="rectangle">
      <solid android:color="@color/color_primary_with_alpha_2" />
      <corners android:radius="@dimen/home_surface_search_box_background_radius" />
    </shape>
  </item>
</layer-list>
