<!--docerion
type: asset
title: Modern toolbar text box background with primary color square drawable
summary: Square rounded rectangle shape filled with the toolbar text box background color at modern toolbar background size.
-->

<shape
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle" >
  <solid android:color="@color/toolbar_text_box_bg_color" />
  <size
      android:width="@dimen/modern_toolbar_background_size"
      android:height="@dimen/modern_toolbar_background_size" />
  <corners android:radius="@dimen/cpa_button_background_radius_is_checked" />
</shape>
