<!--docerion
type: config
title: Quick action search widget styles for sw240dp
summary: Hides the small Lens and Dino buttons on the quick action search widget for small-screen (sw240dp) Android configurations.
-->

<resources>
  <style name="QuickActionSearchWidget.SmallLensButton" parent="QuickActionSearchWidgetSmallButton">
    <item name="android:visibility">gone</item>
  </style>
  <style name="QuickActionSearchWidget.SmallDinoButton" parent="QuickActionSearchWidgetSmallButton">
    <item name="android:visibility">gone</item>
  </style>
</resources>
