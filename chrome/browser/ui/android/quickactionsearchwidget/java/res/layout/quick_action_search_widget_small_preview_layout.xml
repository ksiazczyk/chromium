<!--docerion
type: source
title: Small quick action search widget preview layout
summary: Wraps the small widget layout in a fixed-size frame with a hairline border for the widget picker preview.
-->

<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="@dimen/quick_action_search_widget_width"
    android:layout_height="@dimen/quick_action_search_widget_small_height"
    android:foreground="@drawable/hairline_border"
    tools:ignore="UselessParent">
    <include layout="@layout/quick_action_search_widget_small_layout" />
</FrameLayout>
