<!--docerion
type: source
title: Active mode add account button layout
summary: Android layout for the add account text button shown in the active mode account selection sheet.
-->

<org.chromium.ui.widget.ButtonCompat
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/add_account"
    android:descendantFocusability="blocksDescendants"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginEnd="@dimen/account_selection_sheet_horizontal_margin"
    android:layout_marginStart="@dimen/account_selection_sheet_horizontal_margin"
    android:layout_marginTop="@dimen/account_selection_active_mode_sheet_add_account_button_top_margin"
    android:layout_marginBottom="@dimen/account_selection_sheet_button_margin"
    android:ellipsize="end"
    android:singleLine="true"
    style="@style/TextButton"/>
