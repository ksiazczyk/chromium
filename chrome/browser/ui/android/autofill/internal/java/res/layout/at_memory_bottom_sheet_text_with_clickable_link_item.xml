<!--docerion
type: source
title: AT Memory bottom sheet clickable link text item layout
summary: Layout for a text item in the AT Memory bottom sheet whose text supports clickable links.
-->

<org.chromium.chrome.browser.ui.autofill.AtMemoryBottomSheetTextWithClickableLinkView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="0dp"
    android:paddingVertical="@dimen/at_memory_suggestion_item_padding_vertical">

    <TextView
        android:id="@+id/text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textAppearance="@style/TextAppearance.TextMedium.Secondary" />
</org.chromium.chrome.browser.ui.autofill.AtMemoryBottomSheetTextWithClickableLinkView>
