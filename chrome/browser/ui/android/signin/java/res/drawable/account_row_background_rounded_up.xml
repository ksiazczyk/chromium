<!--docerion
type: asset
title: Account row background rounded at the top
summary: Ripple drawable for account rows whose top corners use the larger card radius while bottom corners stay small.
-->

<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="?android:attr/colorControlHighlight">
    <item>
        <shape
            android:shape="rectangle">
            <solid android:color="?attr/colorSurfaceContainerLow"/>
            <corners android:topLeftRadius="@dimen/card_rounded_corner_radius"
                android:topRightRadius="@dimen/card_rounded_corner_radius"
                android:bottomLeftRadius="@dimen/card_rounded_corner_small_radius"
                android:bottomRightRadius="@dimen/card_rounded_corner_small_radius"/>
        </shape>
    </item>
</ripple>
