<!--docerion
type: source
title: Account picker bottom sheet account row layout
summary: Wraps the shared account row layout for use as a selectable account entry in the bottom sheet account picker.
-->

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="16dp"
    android:clipToOutline="true">

    <include layout="@layout/account_row" />
</LinearLayout>
