<!--docerion
type: source
title: Fullscreen sign-in transition resource
summary: Android transition set that animates the fullscreen sign-in screen, moving the FRE icon and fading in the centered content container.
-->

<transitionSet xmlns:android="http://schemas.android.com/apk/res/android"
    android:transitionOrdering="sequential">

    <transitionSet>
        <targets>
            <target android:targetId="@id/fre_icon" />
        </targets>
        <changeBounds />
        <changeTransform />
        <changeImageTransform />
    </transitionSet>

    <fade android:fadingMode="fade_in">
        <targets>
            <target android:targetId="@id/centered_content_container" />
        </targets>
    </fade>

</transitionSet>
