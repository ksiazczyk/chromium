<!--docerion
type: config
title: Instance switcher item secondary text color list
summary: Android color state list XML that sets the instance switcher item secondary text color, using an on-secondary-container color when selected and an on-surface color otherwise.
-->

<selector xmlns:android="http://schemas.android.com/apk/res/android">
  <item
      android:state_selected="true"
      android:color="?attr/colorOnSecondaryContainer" />
  <item
      android:color="?attr/colorOnSurface" />
</selector>