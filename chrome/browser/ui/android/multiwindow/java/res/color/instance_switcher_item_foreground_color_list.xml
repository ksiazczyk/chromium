<!--docerion
type: config
title: Instance switcher item foreground color list
summary: Android color state list XML that sets the instance switcher item foreground color, using disabled alpha, a selected on-secondary-container color, and an on-surface default.
-->

<selector xmlns:android="http://schemas.android.com/apk/res/android">
  <item
      android:alpha="@dimen/default_disabled_alpha"
      android:state_enabled="false" android:color="?attr/colorOnSurface" />
  <item
      android:state_selected="true"
      android:color="?attr/colorOnSecondaryContainer" />
  <item
      android:color="?attr/colorOnSurface" />
</selector>