<!--docerion
type: asset
title: Enterprise badge icon drawable
summary: Layer-list drawable that draws an oval badge background with a subtle stroke and overlays the enterprise icon inset by 4dp for the Android enterprise signals disclaimer UI.
-->

<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="@macro/default_card_bg_color" />
            <stroke
                android:width="1dp"
                android:color="@color/color_on_surface_with_alpha_10" />
        </shape>
    </item>
    <item
        android:left="4dp"
        android:right="4dp"
        android:top="4dp"
        android:bottom="4dp"
        android:drawable="@drawable/enterprise_icon" />
</layer-list>
