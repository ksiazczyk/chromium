<!--docerion
type: config
title: Landscape dimensions for NTP logo and doodle margins
summary: Defines landscape-specific dimension values for the new tab page logo and doodle top margins, aliasing medium and large sizes to the small values.
-->

<resources>
  <dimen name="ntp_logo_margin_top_small">12dp</dimen>
  <dimen name="ntp_logo_margin_top_medium">@dimen/ntp_logo_margin_top_small</dimen>
  <dimen name="ntp_logo_margin_top_large">@dimen/ntp_logo_margin_top_small</dimen>
  <dimen name="doodle_margin_top_small">8dp</dimen>
  <dimen name="doodle_margin_top_large">@dimen/doodle_margin_top_small</dimen>
</resources>