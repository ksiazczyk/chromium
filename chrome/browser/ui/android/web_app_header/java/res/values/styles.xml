<!--docerion
type: config
title: Header button style resources
summary: Defines an Android style for web app header buttons, setting their background, size from a theme attribute, and image scale type.
-->

<resources>
    <style name="HeaderButton">
        <item name="android:background">@drawable/default_icon_background</item>
        <item name="android:layout_width">?attr/webAppHeaderButtonSize</item>
        <item name="android:layout_height">?attr/webAppHeaderButtonSize</item>
        <item name="android:scaleType">center</item>
    </style>
</resources>
