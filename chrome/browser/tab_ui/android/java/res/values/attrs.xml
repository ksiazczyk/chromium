<!--docerion
type: config
title: TabThumbnailView styleable attributes
summary: Declares custom corner radius attributes (top start, top end, bottom start, bottom end) for the TabThumbnailView styleable in the Android tab UI resources.
-->

<resources>
  <declare-styleable name="TabThumbnailView">
    <attr name="cornerRadiusTopStart" format="dimension" />
    <attr name="cornerRadiusTopEnd" format="dimension" />
    <attr name="cornerRadiusBottomStart" format="dimension" />
    <attr name="cornerRadiusBottomEnd" format="dimension" />
  </declare-styleable>
</resources>