<!--docerion
type: asset
title: Theme preview dialog bottom gradient overlay drawable
summary: Linear gradient shape providing a dark fade at the bottom of the NTP theme preview dialog.
-->

<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="90"
        android:startColor="@color/black_alpha_50"
        android:centerColor="@color/black_alpha_20"
        android:endColor="@android:color/transparent"
        android:type="linear" />
</shape>