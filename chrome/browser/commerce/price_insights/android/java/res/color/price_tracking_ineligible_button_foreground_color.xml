<!--docerion
type: config
title: Price tracking ineligible button foreground color
summary: Android color selector resource that sets the foreground color of the ineligible price tracking button to colorOnSurface with 0.38 alpha.
-->

<selector xmlns:android="http://schemas.android.com/apk/res/android" >
    <item
        android:color="?attr/colorOnSurface"
        android:alpha="0.38"/>
</selector>