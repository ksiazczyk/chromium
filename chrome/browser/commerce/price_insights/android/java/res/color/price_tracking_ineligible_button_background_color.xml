<!--docerion
type: config
title: Price tracking ineligible button background color
summary: Android color selector resource that sets the background color of the ineligible price tracking button to colorOnSurface with 0.12 alpha.
-->

<selector xmlns:android="http://schemas.android.com/apk/res/android" >
    <item
        android:color="?attr/colorOnSurface"
        android:alpha="0.12"/>
</selector>