<!--docerion
type: source
title: ViewFlipper fade-out animation resource
summary: Android XML animation resource that fades a ViewFlipper view out over 100 ms with a decelerate quad interpolator, used by the Android tips UI.
-->

<set xmlns:android="http://schemas.android.com/apk/res/android"
  android:interpolator="@android:interpolator/decelerate_quad">
    <alpha
        android:fromAlpha="1.0"
        android:toAlpha="0.0"
        android:duration="100"/>
</set>