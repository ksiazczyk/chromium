<!--docerion
type: source
title: Bottom item background drawable for tips view list
summary: Android shape drawable that renders the rounded background for the bottom item of the tips view list, with large bottom corners and small top corners tinted to the surface container color.
-->

<shape xmlns:android="http://schemas.android.com/apk/res/android"
  android:shape="rectangle"
    android:tint="?attr/colorSurfaceContainerLow">
  <corners android:topLeftRadius="@dimen/view_list_item_small_radius"
    android:topRightRadius="@dimen/view_list_item_small_radius"
    android:bottomLeftRadius="@dimen/view_list_item_large_radius"
    android:bottomRightRadius="@dimen/view_list_item_large_radius"/>
</shape>
