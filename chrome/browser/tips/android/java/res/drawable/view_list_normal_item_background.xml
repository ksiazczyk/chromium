<!--docerion
type: source
title: Normal item background drawable for tips view list
summary: Android shape drawable that renders the rounded background for a middle item of the tips view list, using the small corner radius on all corners and the surface container color tint.
-->

<shape xmlns:android="http://schemas.android.com/apk/res/android"
  android:shape="rectangle"
    android:tint="?attr/colorSurfaceContainerLow">
  <corners android:topLeftRadius="@dimen/view_list_item_small_radius"
    android:topRightRadius="@dimen/view_list_item_small_radius"
    android:bottomLeftRadius="@dimen/view_list_item_small_radius"
    android:bottomRightRadius="@dimen/view_list_item_small_radius"/>
</shape>
