<!--docerion
type: asset
title: Single tab thumbnail background drawable
summary: Android shape drawable that draws the single tab thumbnail placeholder background with a divider-colored stroke and rounded corners.
-->

<shape xmlns:android="http://schemas.android.com/apk/res/android">
  <solid android:color="@color/thumbnail_placeholder_on_primary_bg"/>
  <stroke
      android:width="1dp"
      android:color="@color/divider_color" />
  <corners android:radius="@dimen/single_tab_thumbnail_radius" />
</shape>
