<!--docerion
type: asset
title: Restore tabs single item background
summary: Ripple drawable giving a standalone restore tabs item a surface-colored background with outer corner radius on all corners.
-->

<org.chromium.chrome.browser.recent_tabs.ui.UnsharableRippleDrawable
  xmlns:android="http://schemas.android.com/apk/res/android"
  android:color="?android:attr/colorControlHighlight">
  <item>
    <shape android:shape="rectangle">
      <solid android:color="?attr/colorSurfaceContainerLow"/>
      <corners android:topLeftRadius="@dimen/restore_tabs_outer_corner_radius"
          android:topRightRadius="@dimen/restore_tabs_outer_corner_radius"
          android:bottomLeftRadius="@dimen/restore_tabs_outer_corner_radius"
          android:bottomRightRadius="@dimen/restore_tabs_outer_corner_radius" />
    </shape>
  </item>
</org.chromium.chrome.browser.recent_tabs.ui.UnsharableRippleDrawable>
