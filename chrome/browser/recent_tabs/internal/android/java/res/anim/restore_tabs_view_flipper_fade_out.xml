<!--docerion
type: config
title: Restore tabs view flipper fade-out animation
summary: Android animation resource that fades the restore tabs view flipper out from opaque to fully transparent over 100 ms with a decelerate quad interpolator.
-->

<set xmlns:android="http://schemas.android.com/apk/res/android"
  android:interpolator="@android:interpolator/decelerate_quad">
    <alpha
        android:fromAlpha="1.0"
        android:toAlpha="0.0"
        android:duration="100"/>
</set>