<!--docerion
type: asset
title: Immersive video button tint color selector
summary: Android color state list that tints the XR immersive video button with the immersive video panel background color when selected and the immersive video theme foreground color otherwise.
-->

<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:state_selected="true"
        android:color="@color/immersive_video_panel_background" />
    <item android:color="@color/immersive_video_theme_foreground" />
</selector>
