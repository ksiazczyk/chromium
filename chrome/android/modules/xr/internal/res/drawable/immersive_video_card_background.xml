<!--docerion
type: asset
title: Immersive video card background
summary: Shape drawable providing a rounded rectangle card background with panel background color, 1dp border, and 24dp corner radius.
-->

<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/immersive_video_panel_background" />
    <stroke
        android:width="1dp"
        android:color="@color/immersive_video_panel_border" />
    <corners android:radius="24dp" />
</shape>
