<!--docerion
type: asset
title: Vertical tabs pinned separator drawable
summary: Shape drawable rendering the sized, rounded separator line between pinned tabs in the vertical tabs list.
-->

<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <size
        android:width="@dimen/vertical_tabs_pinned_separator_width"
        android:height="@dimen/vertical_tabs_pinned_separator_height" />
    <corners android:radius="@dimen/vertical_tabs_pinned_separator_radius" />
    <solid android:color="@color/vertical_tabs_pinned_separator_color" />
</shape>
