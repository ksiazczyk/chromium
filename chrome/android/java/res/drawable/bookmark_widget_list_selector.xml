<!--docerion
type: asset
title: Bookmark widget list item selector
summary: Selector that highlights pressed items in the bookmark widget list and stays transparent otherwise.
-->

<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true" android:drawable="@color/bookmark_widget_pressed_highlight" />
    <item android:drawable="@android:color/transparent" />
</selector>
