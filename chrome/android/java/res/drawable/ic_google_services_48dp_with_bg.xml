<!--docerion
type: asset
title: Google services icon with background, 48dp
summary: Layer-list drawable that overlays the 48dp Google services icon on an oval primary-container background.
-->

<layer-list
    xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:width="40dp"
        android:height="40dp"
        android:left="4dp"
        android:right="4dp"
        android:top="4dp"
        android:bottom="4dp"
        android:drawable="@drawable/oval_primary_container" />
    <item
        android:drawable="@drawable/ic_google_services_48dp"
        android:height="48dp"
        android:width="48dp" />
</layer-list>
