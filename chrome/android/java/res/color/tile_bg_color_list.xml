<!--docerion
type: source
title: Tile background color state list
summary: Android color selector showing a divider color when a tile is hovered and transparent otherwise, marked as unused.
-->

<selector
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="UnusedResources">
    <item android:color="@color/divider_color" android:state_hovered="true"/>
    <item android:color="@android:color/transparent" />
</selector>
