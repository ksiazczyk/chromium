<!--docerion
type: source
title: Tab strip TSB background color state list
summary: Android color selector giving the tab strip TSB background hover, peripheral pressed, pressed, and default surface tints.
-->

<selector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <item android:state_hovered="true"
        android:color="@color/tab_strip_button_bg_hover_tint" />
    <item android:state_pressed="true" app:state_peripheral_pressed="true"
        android:color="@color/tab_strip_button_bg_peripheral_pressed_tint" />
    <item android:state_pressed="true"
        android:color="@color/tab_strip_button_bg_pressed_tint" />

    <item android:color="?attr/colorSurfaceContainerLow" />
</selector>
