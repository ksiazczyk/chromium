<!--docerion
type: config
title: Reader mode prefs font style button text color
summary: Color selector for reader mode preferences font style button text, using colorOnSecondaryContainer when checked and colorOnSurface otherwise.
-->

<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true"
        android:color="?attr/colorOnSecondaryContainer" />
    <item android:state_checked="false" android:color="?attr/colorOnSurface" />
</selector>
