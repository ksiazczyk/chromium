<!--docerion
type: config
title: Tab strip NTB background tint list
summary: Color selector for the NTB background across hover, peripheral press, and press states, defaulting to the primary container color.
-->

<selector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <item android:state_hovered="true"
        android:color="@color/tab_strip_button_bg_hover_tint" />
    <item android:state_pressed="true" app:state_peripheral_pressed="true"
        android:color="@color/tab_strip_button_bg_peripheral_pressed_tint" />
    <item android:state_pressed="true"
        android:color="@color/tab_strip_button_bg_pressed_tint" />

    <item android:color="?attr/colorPrimaryContainer" />
</selector>
