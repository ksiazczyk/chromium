<!--docerion
type: config
title: Tab strip MSB background tint list
summary: Color selector for the MSB background on hover and peripheral press, defaulting to the model selector button background color.
-->

<selector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <item android:state_hovered="true"
        android:color="@color/tab_strip_button_bg_hover_tint" />
    <item android:state_pressed="true" app:state_peripheral_pressed="true"
        android:color="@color/tab_strip_button_bg_peripheral_pressed_tint" />

    <item android:color="@color/model_selector_button_bg_color" />
</selector>
