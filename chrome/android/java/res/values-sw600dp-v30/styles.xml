<!--docerion
type: config
title: Tablet settings theme styles
summary: Android resource XML that overrides the Chromium settings theme for sw600dp devices with status bar, navigation bar, and light-icon color settings.
-->

<resources>
    <style name="Theme.Chromium.Settings" parent="Base.Theme.Chromium.Settings">
        <item name="android:statusBarColor">@macro/default_bg_color</item>
        <item name="android:windowLightStatusBar">@bool/window_light_status_bar</item>
        <item name="android:navigationBarColor">@macro/default_bg_color</item>
        <item name="android:navigationBarDividerColor">@color/divider_color</item>
        <item name="android:windowLightNavigationBar">@bool/window_light_navigation_bar</item>
    </style>
</resources>
