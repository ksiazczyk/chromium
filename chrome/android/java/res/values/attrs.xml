<!--docerion
type: config
title: Custom styleable attributes for Chrome Android views
summary: Declares custom styleable attributes and view states, such as HyperlinkPreference's url and HubToolbarView's newTabButtonStyle, used by Chrome's Android UI.
-->

<resources>
    <declare-styleable name="HyperlinkPreference">
        <!-- The URL to load when the preference is clicked -->
        <attr name="url" format="string" />
    </declare-styleable>

    <declare-styleable name="BookmarkTextInputLayout">
        <attr name="emptyErrorMessage" format="string" />
    </declare-styleable>

    <declare-styleable name="ExploreSitesTileView">
        <attr name="iconCornerRadius" format="dimension"/>
    </declare-styleable>

    <declare-styleable name="ManageAccountDevicesLinkView">
        <attr name="showLink" format="boolean" />
    </declare-styleable>

    <declare-styleable name="HubToolbarView">
        <attr name="newTabButtonStyle" format="reference" />
    </declare-styleable>

    <!-- Custom states for TintedCompositorButton -->
    <attr name="state_peripheral_pressed" format="boolean" />
</resources>
