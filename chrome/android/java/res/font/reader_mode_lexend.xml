<!--docerion
type: asset
title: Lexend downloadable font family resource
summary: Defines the Lexend font family for Reader Mode, fetched asynchronously from the Google Play Services downloadable fonts provider with the sans-serif system fallback.
-->

<font-family
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:ignore="FontValidationError,FontValidationWarning,UnusedResources"
    app:fontProviderAuthority="com.google.android.gms.fonts"
    app:fontProviderCerts="@array/ui_com_google_android_gms_fonts_certs"
    app:fontProviderFetchStrategy="async"
    app:fontProviderPackage="com.google.android.gms"
    app:fontProviderQuery="Lexend"
    app:fontProviderSystemFontFamily="sans-serif"/>
