<!--docerion
type: config
title: Large-screen dialog theme style override
summary: Defines the Theme.Chromium.DialogWhenLarge style for large screens, making the dialog window translucent.
-->

<resources>
    <style name="Theme.Chromium.DialogWhenLarge"
        parent="Base.Theme.Chromium.DialogWhenLarge">
        <item name="android:windowIsTranslucent">true</item>
    </style>
</resources>
