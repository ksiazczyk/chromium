<!--docerion
type: config
title: Slide in from right animation
summary: Defines an animation that translates a view in from the right edge over the system medium animation time.
-->

<set xmlns:android="http://schemas.android.com/apk/res/android">
    <translate android:fromXDelta="100%p" android:toXDelta="0"
        android:duration="@android:integer/config_mediumAnimTime"/>
</set>
