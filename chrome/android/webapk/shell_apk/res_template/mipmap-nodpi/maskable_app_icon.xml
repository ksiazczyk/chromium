<!--docerion
type: source
title: WebAPK maskable app icon bitmap template
summary: Mustache template for the WebAPK shell APK that generates a bitmap drawable referencing the maskable app icon mipmap for the selected density, with icon URL and hash set for the primary icon.
-->

<bitmap xmlns:android="http://schemas.android.com/apk/res/android"
    android:src="@mipmap/maskable_app_icon_{{{icon_density}}}"
  {{#primary_icon}}
    iconUrl="{{{icon_url}}}"
    iconHash="{{{hash}}}"
  {{/primary_icon}}
/>
