<?xml version="1.0" encoding="utf-8" ?>
<!--docerion
type: config
title: Android lint suppressions
summary: Suppresses all lint issues for code under base, components, content, device, media, net, services, third_party, and ui paths.
-->

<lint>
  <!-- Ignore all lint errors in chrome code. -->
  <issue id="all">
    <ignore regexp="\.\./\.\./base/"/>
    <ignore regexp="\.\./\.\./components/"/>
    <ignore regexp="\.\./\.\./content/"/>
    <ignore regexp="\.\./\.\./device/"/>
    <ignore regexp="\.\./\.\./media/"/>
    <ignore regexp="\.\./\.\./net/"/>
    <ignore regexp="\.\./\.\./services/"/>
    <ignore regexp="\.\./\.\./third_party/"/>
    <ignore regexp="\.\./\.\./ui/"/>
  </issue>
</lint>
