<!--docerion
type: source
title: Color picker suggestion view layout
summary: Android layout for a single color suggestion swatch in the HTML color picker, showing a color view inside a bordered touch-target-sized frame.
-->

<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="@dimen/min_touch_target_size"
    android:layout_height="@dimen/min_touch_target_size"
    android:background="@drawable/color_picker_border"
    android:layout_gravity="center"
    android:padding="6dp" >

    <View
        android:id="@+id/color_picker_suggestion_color_view"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent" />

</FrameLayout>