<!--docerion
type: config
title: Android ID resources for context menu actions
summary: Defines ID resources for context menu actions such as opening in browser and copying link address or text, including one ID used only by WebView.
-->

<resources>
    <!-- Context Menu Ids -->
    <item type="id" name="contextmenu_open_in_browser_id" />
    <item type="id" name="contextmenu_copy_link_address" />
    <item type="id" name="contextmenu_copy_link_text" />

    <!-- Only used by WebView -->
    <item type="id" name="contextmenu_open_link_id" />
</resources>