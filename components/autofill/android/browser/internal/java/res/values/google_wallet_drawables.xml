<!--docerion
type: config
title: Google Wallet drawable alias resource
summary: Defines the google_wallet_24dp drawable alias that reuses the shared unbranded Google Wallet gradient icon for Chromium's Android autofill resources.
-->

<resources>
    <!-- Keep the Autofill-specific resource name while sharing the identical
         unbranded Google Wallet icon payload. -->
    <drawable name="google_wallet_24dp">
        @drawable/googlewallet_icon_with_gradient
    </drawable>
</resources>
