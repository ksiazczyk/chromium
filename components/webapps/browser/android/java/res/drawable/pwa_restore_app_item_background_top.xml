        android:color="@color/pwa_bottom_sheet_card_background"/>

    <corners
        android:radius="50dp"
        android:topLeftRadius="25dp"
        android:topRightRadius="25dp"
        android:bottomLeftRadius="0dp"
        android:bottomRightRadius="0dp" />
</shape>
