<!--docerion
type: config
title: Menu chip background color selector
summary: Android color selector that picks the menu chip background color based on the enabled state, using a disabled variant when disabled and the default chip background color otherwise.
-->

<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:color="@color/menu_chip_background_color_disabled" android:state_enabled="false" />
    <item android:color="@color/menu_chip_background_color"/>
</selector>