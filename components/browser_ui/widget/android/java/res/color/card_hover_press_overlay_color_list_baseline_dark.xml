<!--docerion
type: source
title: Baseline dark card hover and press overlay color state list
summary: Baseline dark variant of the card hover and press overlay color state list, using fixed baseline neutral 90 alpha colors for the pressed and hovered states.
-->

<!-- Default color state list paired with card that should have hover / press
     state, while the focus state needs a outline highlight. -->
<selector
  xmlns:android="http://schemas.android.com/apk/res/android"
  xmlns:tools="http://schemas.android.com/tools"
  tools:ignore="UnusedResources">
  <!-- Pressed state: 12% alpha of colorOnSurface -->
  <item android:state_pressed="true"
      android:color="@color/baseline_neutral_90_alpha_12" />

  <!-- Hovered state: 8% alpha of colorOnSurface -->
  <item android:state_hovered="true"
      android:color="@color/baseline_neutral_90_alpha_8" />

  <!-- Focused state: transparent, will be handled by external outline -->
  <!-- Default state: transparent -->
  <item android:color="@android:color/transparent" />
</selector>