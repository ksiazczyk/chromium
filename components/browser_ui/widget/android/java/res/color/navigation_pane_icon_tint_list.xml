<!--docerion
type: config
title: Navigation pane icon tint color selector
summary: Android color selector that tints navigation pane icons with the on-secondary-container theme color when selected and the on-surface-variant color otherwise.
-->

<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:color="?attr/colorOnSecondaryContainer" android:state_selected="true" />
    <item android:color="?attr/colorOnSurfaceVariant" />
</selector>
