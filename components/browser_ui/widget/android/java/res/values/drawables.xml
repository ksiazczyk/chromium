<!--docerion
type: config
title: Browser UI widget drawable aliases
summary: Maps generic drawable names such as btn_delete_24dp and btn_info to specific icon drawables.
-->

<resources>
    <drawable name="ic_more_vert_24dp">
        @drawable/ic_more_vert_24dp_on_light_bg
    </drawable>
    <drawable name="btn_delete_24dp">@drawable/ic_cancel_fill_24dp</drawable>
    <drawable name="btn_info">@drawable/ic_info_24dp</drawable>
    <drawable name="ic_settings_gear_24dp">@drawable/ic_settings_24dp</drawable>
</resources>
