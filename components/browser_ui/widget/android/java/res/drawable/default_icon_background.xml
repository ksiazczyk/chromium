<!--docerion
type: asset
title: Default icon background ripple drawable
summary: Ripple drawable that wraps the default icon background selector at the large icon background size.
-->

<ripple xmlns:android="http://schemas.android.com/apk/res/android"
  android:color="?android:attr/colorControlHighlight">
  <item
    android:id="@android:id/content"
    android:width="@dimen/large_icon_background_size"
    android:height="@dimen/large_icon_background_size"
    android:gravity="center"
    android:drawable="@drawable/default_icon_background_selector" />
</ripple>
