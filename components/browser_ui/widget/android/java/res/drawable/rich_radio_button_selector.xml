<!--docerion
type: asset
title: Rich radio button state selector drawable
summary: Selector drawable that switches the rich radio button icon between a filled green check circle when checked and an unchecked radio icon.
-->

<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true"
          android:drawable="@drawable/ic_check_circle_filled_green_24dp" />

    <item android:drawable="@drawable/ic_custom_radio_unchecked" />
</selector>