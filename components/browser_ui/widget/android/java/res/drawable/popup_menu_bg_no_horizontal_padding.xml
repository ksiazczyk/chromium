<!--docerion
type: asset
title: Popup menu background without horizontal padding
summary: Layer-list drawable providing the popup menu background with vertical shadow insets and padding but no horizontal padding.
-->

<layer-list
    xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:top="@dimen/app_menu_shadow_length"
        android:bottom="@dimen/app_menu_shadow_length">
        <shape
            android:shape="rectangle">
            <corners android:radius="?attr/popupBgCornerRadius" />
            <solid android:color="@color/menu_item_bg_color_baseline" />
            <padding
                android:top="@dimen/app_menu_padding"
                android:bottom="@dimen/app_menu_padding" />
        </shape>
    </item>
</layer-list>
