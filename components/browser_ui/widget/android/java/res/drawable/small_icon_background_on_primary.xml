<!--docerion
type: asset
title: Small icon background ripple drawable for on-primary surfaces
summary: Ripple drawable for small icon backgrounds on primary surfaces, using an on-primary alpha ripple color and the matching on-primary selector.
-->

<ripple xmlns:android="http://schemas.android.com/apk/res/android"
  android:color="@color/color_on_primary_with_alpha_12">
  <item
    android:id="@android:id/content"
    android:width="@dimen/small_icon_background_size"
    android:height="@dimen/small_icon_background_size"
    android:gravity="center"
    android:drawable="@drawable/default_icon_background_on_primary_selector" />
</ripple>
