<!--docerion
type: asset
title: Dialog background without shadow
summary: Shape drawable that fills the dialog background color with the standard dialog corner radius and no shadow.
-->

<shape
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
  <solid android:color="@color/dialog_bg_color" />
  <corners android:radius="@dimen/dialog_corner_radius"/>
</shape>
