<!--docerion
type: config
title: Page zoom style resources
summary: Defines text appearance and slider styles used by the Android page zoom UI, referencing the dimension resources.
-->

<resources>
    <style name="TextAppearance.PageZoomResetButton" parent="TextButton">
        <item name="android:textSize">@dimen/text_size_large</item>
    </style>

    <style name="Widget.PageZoomSlider" parent="Widget.MaterialComponents.Slider">
        <item name="trackHeight">@dimen/page_zoom_slider_track_height</item>
    </style>
</resources>
