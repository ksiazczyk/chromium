<!--docerion
type: asset
title: Slide out left animation
summary: Android animation resource that slides a view out to the left, moving from its position to -100% of the parent over the standard medium animation time.
-->

<set xmlns:android="http://schemas.android.com/apk/res/android">
    <translate android:fromXDelta="0" android:toXDelta="-100%p"
        android:duration="@android:integer/config_mediumAnimTime"/>
</set>
