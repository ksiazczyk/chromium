<!--docerion
type: config
title: Default text color link tint list
summary: Android color selector for link text using the global link text color with a disabled default text state at default disabled alpha.
-->

<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:alpha="@dimen/default_disabled_alpha" android:color="@macro/default_text_color"
        android:state_enabled="false" />
    <item android:color="?attr/globalLinkTextColor"/>
</selector>
