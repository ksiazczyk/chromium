<!--docerion
type: config
title: On-primary color at 12 percent alpha
summary: Color selector that applies 0.12 alpha to the theme's colorOnPrimary attribute for translucent on-primary coloring.
-->

<selector xmlns:android="http://schemas.android.com/apk/res/android">
  <item
    android:alpha="0.12"
    android:color="?attr/colorOnPrimary" />
</selector>
