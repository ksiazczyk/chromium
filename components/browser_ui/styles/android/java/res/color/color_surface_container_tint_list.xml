<!--docerion
type: config
title: Surface container tint list
summary: Color selector applying the theme surface container color, reduced by the default disabled alpha in the disabled state.
-->

<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:alpha="@dimen/default_disabled_alpha"
          android:color="?attr/colorSurfaceContainer" android:state_enabled="false"/>
    <item android:color="?attr/colorSurfaceContainer"/>
</selector>
