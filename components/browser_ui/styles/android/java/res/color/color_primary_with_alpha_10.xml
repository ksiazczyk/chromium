<!--docerion
type: config
title: Primary color at 10 percent alpha
summary: Color selector that applies 0.10 alpha to the theme's colorPrimary attribute for translucent primary coloring.
-->

<selector
    xmlns:android="http://schemas.android.com/apk/res/android">
  <item android:alpha="0.10" android:color="?attr/colorPrimary" />
</selector>