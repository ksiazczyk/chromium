<!--docerion
type: config
title: Default text color on accent1 container state list
summary: Android color state list for text on an accent1 container, using the default_text_color macro with disabled alpha for the disabled state.
-->

<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:alpha="@dimen/default_disabled_alpha" android:color="@macro/default_text_color"
        android:state_enabled="false" />
    <item android:color="@macro/default_text_color_on_accent1_container"/>
</selector>
