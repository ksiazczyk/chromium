<!--docerion
type: config
title: On-surface color at 12 percent alpha
summary: Color selector that applies 0.12 alpha to the theme's colorOnSurface attribute for translucent on-surface coloring.
-->

<selector xmlns:android="http://schemas.android.com/apk/res/android">
  <item
    android:alpha="0.12"
    android:color="?attr/colorOnSurface" />
</selector>
