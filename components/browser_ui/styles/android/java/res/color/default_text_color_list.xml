<!--docerion
type: config
title: Default text color state list
summary: Android color state list that renders default text with colorOnSurface and applies the default disabled alpha when not enabled.
-->

<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:alpha="@dimen/default_disabled_alpha"
        android:color="?attr/colorOnSurface" android:state_enabled="false"/>
    <item android:color="?attr/colorOnSurface" />
</selector>
