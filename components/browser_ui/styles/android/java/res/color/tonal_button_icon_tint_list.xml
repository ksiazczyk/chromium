<!--docerion
type: config
title: Tonal button icon tint list
summary: Android color selector defining tonal button icon tints for disabled, selected, checked and default states.
-->

<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false"
        android:color="?attr/colorOnSurface" android:alpha="0.38"/>
    <item android:state_selected="true"
        android:color="?attr/colorOnSecondaryContainer"/>
    <item android:state_checked="true"
        android:color="?attr/colorOnSecondaryContainer"/>
    <item android:color="?attr/colorOnSurface"/>
</selector>