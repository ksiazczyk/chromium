<!--docerion
type: asset
title: List item bottom-left background drawable
summary: Android shape drawable that rounds the bottom-left list item corners and fills it with the surface container color.
-->

<shape
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <corners
        android:topLeftRadius="@dimen/card_rounded_corner_small_radius"
        android:topRightRadius="@dimen/card_rounded_corner_small_radius"
        android:bottomLeftRadius="@dimen/card_rounded_corner_radius"
        android:bottomRightRadius="@dimen/card_rounded_corner_small_radius" />
    <solid android:color="?attr/colorSurfaceContainer"/>
</shape>
