<!--docerion
type: config
title: Tablet style overrides for browser UI
summary: Overrides the ModernToolbar background and the fullscreen theme overlay for tablet-sized screens in the browser UI resources.
-->

<resources>
    <style name="ModernToolbar" parent="Base.ModernToolbar">
        <item name="android:background">@null</item>
    </style>

    <style name="ThemeOverlay.BrowserUI.Fullscreen"
        parent="Base.ThemeOverlay.BrowserUI.Fullscreen" />
</resources>
