<!--docerion
type: asset
title: Bottom sheet desktop background drawable
summary: Android drawable XML defining a rounded rectangle background for the desktop bottom sheet using the default background color macro and popup corner radius attribute.
-->

<shape
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle" >
    <solid android:color="@macro/default_bg_color" />
    <corners android:radius="?attr/popupBgCornerRadius" />
</shape>
