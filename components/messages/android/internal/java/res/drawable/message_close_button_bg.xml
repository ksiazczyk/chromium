<!--docerion
type: asset
title: Message close button background drawable
summary: Android layer-list drawable providing an oval card-colored background with the default icon background for the message close button.
-->

<layer-list
    xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape
            android:shape="oval">
            <solid android:color="@macro/default_card_bg_color"/>
        </shape>
    </item>
    <item android:drawable="@drawable/default_icon_background" />
</layer-list>