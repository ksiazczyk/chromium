<!--docerion
type: test
title: Android manifest for the media router test support APK
summary: Declares permissions and the exported test media route provider service used by the media router cast emulator test support APK.
-->

  <manifest xmlns:android="http://schemas.android.com/apk/res/android"
      xmlns:tools="http://schemas.android.com/tools"
      package="org.chromium.components.media_router.test_support">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <application>
        <service android:name="org.chromium.components.media_router.cast_emulator.TestMediaRouteProviderService"
                android:label="testMediaRouteProviderService"
                android:process=":mrp"
                tools:ignore="ExportedService"
                android:exported="true">
            <intent-filter>
                <action android:name="android.media.MediaRouteProviderService" />
            </intent-filter>
        </service>
    </application>
</manifest>
