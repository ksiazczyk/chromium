<!--docerion
type: asset
title: Item chooser row text color selector
summary: Android color state list that sets the item chooser row text color for selected, disabled, and default states.
-->

<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:color="@macro/default_text_color_on_accent1" android:state_selected="true"/>
    <item android:alpha="@dimen/default_disabled_alpha"
        android:color="@macro/default_text_color" android:state_enabled="false"/>
    <item android:color="@macro/default_text_color"/>
</selector>
