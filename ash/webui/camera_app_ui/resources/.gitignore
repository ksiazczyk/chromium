# ---docerion
# type: config
# title: Camera App resources gitignore
# summary: Lists generated files such as tsconfig.json, the mojom symlink, and dist that are excluded from version control because they are produced by the cca.py tooling.
# ---

# tsconfig.json is generated by `cca.py tsc <board>`. Since the file contains
# reference to mojom ts types from the generated folder, it's excluded here.
tsconfig.json
# mojom is symbolic linked by `cca.py tsc <board>` to board specific generated
# TypeScript mojom bindings.
mojom
# dist is generated by `cca.py bundle <board>`.
dist
