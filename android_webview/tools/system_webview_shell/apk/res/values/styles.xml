<!--docerion
type: config
title: WebView shell style resources
summary: Defines the UrlText and UrlTextError text styles, which apply the normal and error URL colors to text in the WebView shell UI.
-->

<resources>
    <style name="UrlText">
        <item name="android:textColor">@color/url_color</item>
    </style>
    <style name="UrlTextError">
        <item name="android:textColor">@color/url_error_color</item>
    </style>
</resources>
