<!--docerion
type: config
title: Android manifest pinning minSdkVersion for boundary interface lint
summary: Hardcodes minSdkVersion 24 so the boundary interfaces compile and lint against the AndroidX WebKit module's minimum SDK version.
-->

<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="no.manifest.configured"
    android:versionCode="1"
    android:versionName="1.0">
    <!--
      This is to verify that the boundary interfaces compile and lint correctly
      against the minSdkVersion of the webkit AndroidX module. This needs to be
      hardcoded to exactly match whatever AndroidX WebKit uses for their minSdkVersion,
      and we should update this number as AndroidX changes their minSdkVersion.
      See http://crbug.com/828184 for more details.
    -->
    <uses-sdk android:minSdkVersion="24"/>
</manifest>
