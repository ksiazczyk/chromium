<?xml version="1.0" encoding="utf-8"?>
<!--docerion
type: asset
title: Blue circle drawable
summary: Android shape drawable that renders a 10dp blue oval used as a graphical asset in the WebView dev UI.
-->

<shape
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/blue_circle"
    android:shape="oval">
    <solid android:color="@color/blue"/>
    <size
        android:width="10dp"
        android:height="10dp"/>
</shape>
