# ---docerion
# type: config
# title: Gitignore for page set binaries and archives
# summary: Ignores media files, WPR archives, and fetched-file timestamps under tools/perf/page_sets.
# ---

*.gif
*.jpeg
*.jpg
*.m4a
*.mp3
*.mp4
*.ogg
*.ogv
*.png
*.wav
*.webm
*.wpr
*.wprgo

maps_perf_test/dataset/load_dataset

# Generated fetched binary's timestamp
# See details in py_utils.cloud_storage.GetIfChanged(file_path, bucket) method.
*.fetchts
