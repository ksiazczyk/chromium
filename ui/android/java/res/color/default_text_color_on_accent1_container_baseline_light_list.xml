<!--docerion
type: source
title: Text color on accent1 container selector (baseline, light)
summary: Color selector for text on an accent1 container using baseline primary 90 with reduced alpha when disabled.
-->

<selector xmlns:android="http://schemas.android.com/apk/res/android">
  <item android:alpha="@dimen/default_disabled_alpha" android:color="@color/baseline_primary_90"
    android:state_enabled="false" />
  <item android:color="@color/baseline_primary_90" />
</selector>