<!--docerion
type: asset
title: Menu list item text color state list
summary: Android color selector that applies a disabled-alpha text color to menu list items when disabled and the normal text color otherwise.
-->

<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:alpha="@dimen/default_disabled_alpha"
        android:color="@color/menu_list_item_text_color_disabled" android:state_enabled="false"/>
    <item android:color="@color/menu_list_item_text_color" />
</selector>
