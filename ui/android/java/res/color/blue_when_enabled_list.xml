<!--docerion
type: source
title: Blue when enabled color selector for lists
summary: Baseline color selector that shows link text in blue when enabled and a disabled link color otherwise.
-->

<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:color="@color/default_text_color_link_disabled_baseline" android:state_enabled="false" />
    <item android:color="@color/default_text_color_link_baseline"/>
</selector>
