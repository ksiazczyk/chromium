<!--docerion
type: asset
title: Menu list item icon color state list
summary: Android color selector that dims the menu list item icon with a disabled alpha when the item is disabled and uses the normal icon color otherwise.
-->

<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:alpha="@dimen/default_disabled_alpha"
        android:color="@color/menu_list_item_icon_color_disabled" android:state_enabled="false"/>
    <item android:color="@color/menu_list_item_icon_color" />
</selector>
