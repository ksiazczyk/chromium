<!--docerion
type: source
title: Menu exit fade animation
summary: Defines a 150 ms fade-out animation for closing menus, using the emphasized interpolator.
-->

<set xmlns:android="http://schemas.android.com/apk/res/android" android:shareInterpolator="false">
    <alpha android:interpolator="@anim/emphasized"
        android:fromAlpha="1"
        android:toAlpha="0"
        android:duration="150" />
</set>
