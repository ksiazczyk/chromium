<!--docerion
type: test
title: Custom font family for Android JUnit tests
summary: Defines a font-family resource that maps the test_font_file.ttf font, a copy of third_party test fonts, for use in Android JUnit tests.
-->

<font-family xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- test_font_file.ttf is a copy of third_party/test_fonts
         GardinerModCat.ttf. -->
    <font
        android:font="@font/test_font_file"
        android:fontStyle="normal"
        android:fontWeight="400" />
</font-family>
